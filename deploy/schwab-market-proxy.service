# systemd user unit. Installation: docs/deployment.md
[Unit]
Description=Schwab market data proxy
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/schwab-market-proxy
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
