# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/schwab-market-proxy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now schwab-market-proxy
#   loginctl enable-linger "$USER"   # keep running without an open login session
[Unit]
Description=Schwab market data proxy
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/schwab-market-proxy
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
