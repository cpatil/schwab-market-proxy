# From your app at https://developer.schwab.com (status must be "Ready For Use").
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=

# Must match the callback URL registered on that app exactly.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Dashboard/proxy port.
PORT=8787

# Interface to listen on. 127.0.0.1 = this machine only; 0.0.0.0 = all interfaces.
BIND_HOST=127.0.0.1

# Extra host names/IPs (no port) clients may use, besides 127.0.0.1/localhost.
# Requests under any other name are rejected, so list every LAN/tailnet name you use,
# e.g. 192.168.1.50,myserver.local,myserver,myserver.example-tailnet.ts.net
ALLOWED_HOSTS=

# Optional: other local web apps allowed to read the proxy from a browser,
# comma separated, e.g. http://localhost:5173
CORS_ORIGINS=
